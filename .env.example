# Lovable Modern — own Supabase project (public client only, never commit keys).
# Copy to .env.local and fill from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_paste_here

# API server (required — no fallback, no mock mode)
VITE_API_URL=https://YOUR-API-HOST

# PostHog product analytics (public client key — safe for frontend env)
VITE_POSTHOG_KEY=phc_paste_here
VITE_POSTHOG_HOST=https://us.posthog.com

# Server-only (Workers bindings / Supabase secrets, NO VITE_ prefix):
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_URL, RESEND_API_KEY, EMAIL_FROM, SESSION_SECRET
