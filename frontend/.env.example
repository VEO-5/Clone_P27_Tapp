# Copy to .env and fill in. Never commit real keys.

# Supabase — leave blank to use the local .data/ fallback store
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ticket-attachments

# Admin session (default access code is pearl27)
ADMIN_ACCESS_CODE=pearl27
SESSION_SECRET=change-me-in-production

# Optional transactional email — without this, emails are logged only
RESEND_API_KEY=
EMAIL_FROM=Pearl 27 Support <onboarding@resend.dev>
SUPPORT_INBOX_EMAIL=

# Public URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
