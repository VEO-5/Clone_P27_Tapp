# Mirror local dev. Production sets VITE_API_MOCK=false + VITE_API_URL=https://…
VITE_API_URL=http://localhost:4000
VITE_API_MOCK=true

# InsForge (frontend anon client — copy values from root .env.local, never commit keys)
VITE_INSFORGE_URL=https://YOUR-APPKEY.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=anon_paste_here

# PostHog product analytics (public client key — safe for frontend env)
VITE_POSTHOG_KEY=phc_paste_here
VITE_POSTHOG_HOST=https://us.posthog.com
