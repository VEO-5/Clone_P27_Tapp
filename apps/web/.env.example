# Copy to .env.local. The web app is UI-only — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend handoff switch.
# true (default, local dev): MSW worker serves reference data from src/mocks, no backend needed.
# false (production): talk to the real API at NEXT_PUBLIC_API_URL (set it to https://…).
# Deploy rule: production MUST set NEXT_PUBLIC_API_MOCK=false so no mock code ships.
# Reference spec: apps/web/src/mocks/handlers.ts until backend parity, then delete src/mocks.
NEXT_PUBLIC_API_MOCK=true
