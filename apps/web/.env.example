# Copy to .env.local. The web app is UI-only — no secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Demo data switch — keep true until the real backend is ready.
# true (default): MSW worker serves mock tickets/auth locally, no backend needed.
# false: talk to the real API at NEXT_PUBLIC_API_URL (set it to https://…).
# Swap day = flip this to false + point URL at the real API. No code change.
NEXT_PUBLIC_API_MOCK=true
